<scroll-view scroll-x class="tabs" enable-flex>
  <view wx:for="{{domains}}" wx:key="key" data-key="{{item.key}}" bindtap="pick"
        class="tab {{item.key === current ? 'on' : ''}}">{{item.name}}</view>
</scroll-view>

<view class="card" wx:if="{{error}}"><text>{{error}}</text><view class="tip">下拉重试</view></view>
<view class="tip" wx:elif="{{loading}}">加载中…</view>
<view class="card" wx:elif="{{empty}}">该领域还没有简报，稍后再来。</view>
<view class="card" wx:else>
  <block wx:for="{{blocks}}" wx:key="index">
    <view class="{{item.t}}">{{item.text}}</view>
    <view wx:if="{{item.url}}" class="link" data-url="{{item.url}}" bindtap="copy">复制原文链接</view>
  </block>
</view>
<view class="tip">内容由 AI 基于公开资料生成，仅供参考，请以原文为准</view>
